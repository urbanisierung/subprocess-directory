---
import BaseLayout from "../layouts/BaseLayout.astro";
import { useTranslations } from "../i18n/ui";

const t = useTranslations("en");
---

<BaseLayout title={t("home.title")}>
  <div class="max-w-screen-xl mx-auto px-6 lg:px-12 py-12">
    <div class="text-center mb-12">
      <h1 class="text-5xl font-bold mb-4 text-gray-900 dark:text-white">{t("home.title")}</h1>
      <p class="text-xl text-gray-600 dark:text-gray-400">{t("home.subtitle")}</p>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        Browse like Netflix. Drop it in. Done.
      </p>
      <div class="mt-8 flex justify-center gap-4">
        <a
          href="/browse"
          class="px-6 py-3 bg-orangemunda text-white rounded-lg hover:opacity-90 transition-opacity font-medium"
        >
          Browse Processes
        </a>
        <a
          href="/demo"
          class="px-6 py-3 border border-gray-300 dark:border-gray-700 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors font-medium text-gray-900 dark:text-white"
        >
          View Demo
        </a>
      </div>
    </div>

    <div class="mt-16">
      <h2 class="text-2xl font-semibold mb-6 text-gray-900 dark:text-white">Feature Status</h2>
      <div class="bg-white dark:bg-gray-900 p-8 rounded-lg border border-gray-200 dark:border-gray-800">
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-4">
          We're building a catalog of reusable BPMN subprocesses.
        </p>
        <ul class="space-y-2 text-gray-600 dark:text-gray-400">
          <li>✅ Monorepo setup with pnpm + Turborepo</li>
          <li>✅ Astro 5 + React + Tailwind CSS</li>
          <li>✅ BPMN.js integration for interactive diagrams</li>
          <li>✅ i18n support (en, de, es)</li>
          <li>✅ Content collections for subprocess metadata</li>
          <li>✅ Command Palette with Cmd+K search</li>
          <li>✅ Faceted Sidebar filters</li>
          <li>✅ Netflix-style grid layout</li>
          <li>✅ Dark mode support</li>
          <li>🔨 Static SVG previews for listing pages</li>
          <li>🔨 Pagefind search integration</li>
          <li>🔨 GitHub Discussions integration</li>
        </ul>
      </div>
    </div>

    <div class="mt-12">
      <h3 class="text-xl font-semibold mb-4 text-gray-900 dark:text-white">Technical Stack</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white dark:bg-gray-900 p-6 rounded-lg border border-gray-200 dark:border-gray-800">
          <h4 class="font-semibold mb-2 text-gray-900 dark:text-white">Framework</h4>
          <p class="text-sm text-gray-600 dark:text-gray-400">Astro 5 + React 19</p>
        </div>
        <div class="bg-white dark:bg-gray-900 p-6 rounded-lg border border-gray-200 dark:border-gray-800">
          <h4 class="font-semibold mb-2 text-gray-900 dark:text-white">Styling</h4>
          <p class="text-sm text-gray-600 dark:text-gray-400">Tailwind CSS 3.4</p>
        </div>
        <div class="bg-white dark:bg-gray-900 p-6 rounded-lg border border-gray-200 dark:border-gray-800">
          <h4 class="font-semibold mb-2 text-gray-900 dark:text-white">BPMN Engine</h4>
          <p class="text-sm text-gray-600 dark:text-gray-400">bpmn-js 18</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
