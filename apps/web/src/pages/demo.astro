---
import BaseLayout from "../layouts/BaseLayout.astro";
import BPMNViewer from "../components/BPMNViewer";
import { readFile } from "node:fs/promises";
import { join } from "node:path";

// Read the BPMN file
const bpmnPath = join(process.cwd(), "src/content/subprocesses/en/invoice-approval/process.bpmn");
const bpmnXml = await readFile(bpmnPath, "utf-8");
---

<BaseLayout title="Invoice Approval Process - Subprocess Hub">
  <div class="max-w-screen-xl mx-auto px-6 lg:px-12 py-12">
    <div class="mb-8">
      <h1 class="text-4xl font-bold mb-4">Invoice Approval Process</h1>
      <p class="text-lg text-misty-grey mb-4">
        A simple subprocess for reviewing and approving invoices with automatic payment processing
      </p>
      <div class="flex gap-2 flex-wrap">
        <span class="px-3 py-1 bg-spacecraft text-sm rounded-full">finance</span>
        <span class="px-3 py-1 bg-spacecraft text-sm rounded-full">approval</span>
        <span class="px-3 py-1 bg-spacecraft text-sm rounded-full">automation</span>
        <span class="px-3 py-1 bg-greenmunda/20 text-greenmunda text-sm rounded-full font-medium">
          Simple
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <div class="bg-white rounded-lg border border-concrete-grey p-4">
          <BPMNViewer client:only="react" xml={bpmnXml} />
        </div>
      </div>

      <div class="space-y-6">
        <div class="bg-white p-6 rounded-lg border border-concrete-grey">
          <h3 class="font-semibold mb-4">Actions</h3>
          <div class="space-y-3">
            <button
              class="w-full px-4 py-2 border border-gray-900 rounded hover:bg-spacecraft transition-colors"
            >
              Download XML
            </button>
            <button
              class="w-full px-4 py-2 border border-gray-900 rounded hover:bg-spacecraft transition-colors"
            >
              Copy to Clipboard
            </button>
            <a
              href="https://github.com"
              class="block w-full px-4 py-2 text-center border border-gray-900 rounded hover:bg-spacecraft transition-colors"
            >
              Edit on GitHub
            </a>
          </div>
        </div>

        <div class="bg-white p-6 rounded-lg border border-concrete-grey">
          <h3 class="font-semibold mb-2">Metadata</h3>
          <dl class="space-y-2 text-sm">
            <div>
              <dt class="text-misty-grey">Author</dt>
              <dd class="font-medium">subprocess-hub</dd>
            </div>
            <div>
              <dt class="text-misty-grey">Published</dt>
              <dd class="font-medium">January 15, 2024</dd>
            </div>
            <div>
              <dt class="text-misty-grey">Complexity</dt>
              <dd class="font-medium">Low</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>

    <div class="mt-12">
      <h2 class="text-2xl font-semibold mb-4">Process Description</h2>
      <div class="bg-white p-6 rounded-lg border border-concrete-grey prose max-w-none">
        <p>
          This subprocess handles the complete invoice approval workflow:
        </p>
        <ol>
          <li><strong>Invoice Received:</strong> The process starts when an invoice is received</li>
          <li><strong>Review Invoice:</strong> A user reviews the invoice details</li>
          <li><strong>Approval Decision:</strong> The reviewer decides whether to approve or reject</li>
          <li><strong>Process Payment:</strong> If approved, payment is automatically processed</li>
          <li><strong>Completion:</strong> The process ends with either payment processed or invoice rejected</li>
        </ol>
      </div>
    </div>
  </div>
</BaseLayout>
